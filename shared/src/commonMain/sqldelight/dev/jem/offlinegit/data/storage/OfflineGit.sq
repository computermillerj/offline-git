CREATE TABLE Account (
    id INTEGER NOT NULL PRIMARY KEY,
    login TEXT NOT NULL,
    avatarUrl TEXT,
    -- Monotonic activation counter (no wall clock needed): the account with
    -- the highest value is the active one.
    lastUsedAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE Repository (
    id INTEGER NOT NULL PRIMARY KEY,
    owner TEXT NOT NULL,
    name TEXT NOT NULL,
    defaultBranch TEXT NOT NULL,
    isPrivate INTEGER NOT NULL,
    updatedAt TEXT,
    UNIQUE(owner, name)
);

-- Which accounts can see which repositories. Repository rows are shared
-- (keyed by GitHub's global id), so visibility is a junction, not a column.
CREATE TABLE AccountRepository (
    accountId INTEGER NOT NULL,
    repositoryId INTEGER NOT NULL,
    PRIMARY KEY(accountId, repositoryId),
    FOREIGN KEY(accountId) REFERENCES Account(id) ON DELETE CASCADE,
    FOREIGN KEY(repositoryId) REFERENCES Repository(id) ON DELETE CASCADE
);

CREATE TABLE Branch (
    repositoryId INTEGER NOT NULL,
    name TEXT NOT NULL,
    headSha TEXT NOT NULL,
    downloadedAt TEXT,
    PRIMARY KEY(repositoryId, name),
    FOREIGN KEY(repositoryId) REFERENCES Repository(id) ON DELETE CASCADE
);

CREATE TABLE GitCommit (
    sha TEXT NOT NULL PRIMARY KEY,
    repositoryId INTEGER NOT NULL,
    firstParentSha TEXT,
    authorName TEXT,
    authorEmail TEXT,
    message TEXT NOT NULL,
    committedAt TEXT,
    parentCount INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY(repositoryId) REFERENCES Repository(id) ON DELETE CASCADE
);

CREATE TABLE BranchCommit (
    repositoryId INTEGER NOT NULL,
    branchName TEXT NOT NULL,
    sha TEXT NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY(repositoryId, branchName, sha),
    FOREIGN KEY(repositoryId, branchName) REFERENCES Branch(repositoryId, name) ON DELETE CASCADE,
    FOREIGN KEY(sha) REFERENCES GitCommit(sha) ON DELETE CASCADE
);

CREATE TABLE CommitFile (
    commitSha TEXT NOT NULL,
    path TEXT NOT NULL,
    previousPath TEXT,
    status TEXT NOT NULL,
    additions INTEGER NOT NULL,
    deletions INTEGER NOT NULL,
    patchId TEXT,
    oldBlobSha TEXT,
    newBlobSha TEXT,
    PRIMARY KEY(commitSha, path),
    FOREIGN KEY(commitSha) REFERENCES GitCommit(sha) ON DELETE CASCADE
);

CREATE TABLE DownloadJob (
    id TEXT NOT NULL PRIMARY KEY,
    repositoryId INTEGER NOT NULL,
    branchName TEXT NOT NULL,
    status TEXT NOT NULL,
    progress REAL NOT NULL,
    errorMessage TEXT,
    FOREIGN KEY(repositoryId, branchName) REFERENCES Branch(repositoryId, name) ON DELETE CASCADE
);

-- Single-row table remembering where the user was (repo/branch/commit/file)
-- so the app restores the same view after process death.
CREATE TABLE Selection (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    repositoryId INTEGER,
    branchName TEXT,
    commitSha TEXT,
    filePath TEXT
);

selectAccounts:
SELECT * FROM Account ORDER BY login;

-- The active account is simply the most recently touched one.
selectActiveAccount:
SELECT * FROM Account ORDER BY lastUsedAt DESC, login LIMIT 1;

-- INSERT OR REPLACE would zero lastUsedAt on re-registration, so carry the
-- previous value over. (UPSERT syntax needs SQLite 3.24; minSdk 26 has 3.18.)
upsertAccount:
INSERT OR REPLACE INTO Account(id, login, avatarUrl, lastUsedAt)
VALUES (:id, :login, :avatarUrl, COALESCE((SELECT lastUsedAt FROM Account WHERE id = :id), 0));

touchAccount:
UPDATE Account
SET lastUsedAt = (SELECT COALESCE(MAX(lastUsedAt), 0) + 1 FROM Account)
WHERE id = ?;

deleteAccount:
DELETE FROM Account WHERE id = ?;

insertAccountRepository:
INSERT OR REPLACE INTO AccountRepository(accountId, repositoryId)
VALUES (?, ?);

deleteAccountRepositories:
DELETE FROM AccountRepository
WHERE accountId = ?;

selectRepositoriesForAccount:
SELECT Repository.* FROM Repository
JOIN AccountRepository ON AccountRepository.repositoryId = Repository.id
WHERE AccountRepository.accountId = ?
ORDER BY Repository.owner, Repository.name;

-- Offline data an account leaves behind is only removed when no other
-- account can still see the repository. Deletion is explicit per table:
-- foreign keys are off (see AndroidStorageFactory), so cascades never fire.
selectRepositoryIdsOnlyVisibleToAccount:
SELECT repositoryId FROM AccountRepository
WHERE accountId = :accountId
  AND repositoryId NOT IN (SELECT repositoryId FROM AccountRepository WHERE accountId != :accountId);

deleteCommitFilesForRepository:
DELETE FROM CommitFile
WHERE commitSha IN (SELECT sha FROM GitCommit WHERE repositoryId = ?);

deleteBranchCommitsForRepository:
DELETE FROM BranchCommit
WHERE repositoryId = ?;

deleteCommitsForRepository:
DELETE FROM GitCommit
WHERE repositoryId = ?;

deleteDownloadJobsForRepository:
DELETE FROM DownloadJob
WHERE repositoryId = ?;

deleteRepository:
DELETE FROM Repository
WHERE id = ?;

selectSelection:
SELECT * FROM Selection WHERE id = 1;

upsertSelection:
INSERT OR REPLACE INTO Selection(id, repositoryId, branchName, commitSha, filePath)
VALUES (1, ?, ?, ?, ?);

selectRepositories:
SELECT * FROM Repository ORDER BY owner, name;

upsertRepository:
INSERT OR REPLACE INTO Repository(id, owner, name, defaultBranch, isPrivate, updatedAt)
VALUES (?, ?, ?, ?, ?, ?);

selectBranches:
SELECT * FROM Branch
WHERE repositoryId = ?
ORDER BY name;

deleteBranches:
DELETE FROM Branch
WHERE repositoryId = ?;

upsertBranch:
INSERT OR REPLACE INTO Branch(repositoryId, name, headSha, downloadedAt)
VALUES (?, ?, ?, ?);

selectCommitsForBranch:
SELECT
    GitCommit.sha,
    GitCommit.firstParentSha,
    GitCommit.authorName,
    GitCommit.authorEmail,
    GitCommit.message,
    GitCommit.committedAt,
    GitCommit.parentCount,
    COALESCE(SUM(CommitFile.additions), 0) AS additions,
    COALESCE(SUM(CommitFile.deletions), 0) AS deletions
FROM BranchCommit
JOIN GitCommit ON GitCommit.sha = BranchCommit.sha
LEFT JOIN CommitFile ON CommitFile.commitSha = GitCommit.sha
WHERE BranchCommit.repositoryId = ? AND BranchCommit.branchName = ?
GROUP BY GitCommit.sha, BranchCommit.position
ORDER BY BranchCommit.position;

selectCommitBySha:
SELECT * FROM GitCommit
WHERE sha = ?;

upsertCommit:
INSERT OR REPLACE INTO GitCommit(
    sha,
    repositoryId,
    firstParentSha,
    authorName,
    authorEmail,
    message,
    committedAt,
    parentCount
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteBranchCommits:
DELETE FROM BranchCommit
WHERE repositoryId = ? AND branchName = ?;

insertBranchCommit:
INSERT OR REPLACE INTO BranchCommit(repositoryId, branchName, sha, position)
VALUES (?, ?, ?, ?);

selectFilesForCommit:
SELECT * FROM CommitFile
WHERE commitSha = ?
ORDER BY path;

deleteFilesForCommit:
DELETE FROM CommitFile
WHERE commitSha = ?;

upsertCommitFile:
INSERT OR REPLACE INTO CommitFile(
    commitSha,
    path,
    previousPath,
    status,
    additions,
    deletions,
    patchId,
    oldBlobSha,
    newBlobSha
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectDownloadJobForBranch:
SELECT * FROM DownloadJob
WHERE repositoryId = ? AND branchName = ?
LIMIT 1;

selectDownloadedRepositoryIds:
SELECT DISTINCT repositoryId FROM DownloadJob
WHERE status = 'COMPLETED';

upsertDownloadJob:
INSERT OR REPLACE INTO DownloadJob(
    id,
    repositoryId,
    branchName,
    status,
    progress,
    errorMessage
)
VALUES (?, ?, ?, ?, ?, ?);
